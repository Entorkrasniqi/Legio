# Secret scan first: a commit that looks like it contains a key is blocked,
# not just flagged (docs/DEVOPS.md, docs/SECURITY.md). Fails closed — if
# gitleaks isn't installed, the commit is refused rather than going unscanned.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes can't be scanned for secrets."
  echo "Install it with:  brew install gitleaks"
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose

npx lint-staged
